{
  "manifest_version": 3,
  "name": "bm59-probe",
  "version": "0.0.1",
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["cs.js"], "run_at": "document_start", "all_frames": true, "world": "ISOLATED" }]
}
